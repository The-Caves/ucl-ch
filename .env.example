# UCL Cornhole Hub — safe template only. Keep the actual .env file local.
# Do not paste secrets into ChatGPT, source code, or committed env templates.
#
# Reserved for the FUTURE bundled frontend. The current GitHub Pages app does
# not read .env files and does not yet connect to Supabase.
#
# Browser-safe values only (after Row Level Security has been configured):
UCL_SUPABASE_URL=
UCL_SUPABASE_PUBLISHABLE_KEY=

# Server-only keys, database passwords and GitHub staging test account
# credentials intentionally do not appear in this template.
# Store them in Supabase/hosting secret managers or protected GitHub Environments.
